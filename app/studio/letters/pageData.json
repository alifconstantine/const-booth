{
  "title": "Write a Handwritten Letter Online Free | ConstBooth Studio",
  "description": "Write a free handwritten-style letter online. Choose paper, ink and fonts, add photos, then share it as a private link or save it to print. No account needed.",
  "styles": [
    "/css/studio-paper.css",
    "/css/letters.css",
    "/css/studio-info.css",
    "/css/site-consent.css"
  ],
  "bodyClass": "lt-page-body",
  "bodyAttrs": {},
  "html": "<a href=\"#main-content\" class=\"skip-link\">Skip to content</a><header class=\"mobile-header\"><a href=\"/studio\" class=\"mobile-back-btn\" id=\"mobile-back-btn\" aria-label=\"Go Back to Studio\" title=\"Back\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"20\" height=\"20\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg></a><a href=\"/\" class=\"mobile-logo\" aria-label=\"ConstBooth\"><img src=\"/assets/logo.svg?v=35ddb567\" alt=\"ConstBooth\" class=\"logo-img\" width=\"112\" height=\"30\"></a><button type=\"button\" class=\"lb-info-btn\" data-info-open aria-haspopup=\"dialog\" aria-controls=\"lb-info\" aria-label=\"How this works\" title=\"How this works\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16.5\"/><line x1=\"12\" y1=\"7.5\" x2=\"12.01\" y2=\"7.5\"/></svg></button></header><header class=\"main-header full-header lb-nav-bar\"><div class=\"header-left\"><a href=\"/studio\" id=\"nav-back-btn\" class=\"nav-back-btn\" aria-label=\"Back to Studio\" title=\"Back\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"18\" height=\"18\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg></a></div><a href=\"/\" id=\"logo-trigger\" class=\"app-logo\" aria-label=\"ConstBooth\"><img src=\"/assets/logo.svg?v=35ddb567\" alt=\"ConstBooth\" class=\"logo-img\" width=\"134\" height=\"36\"></a><div class=\"header-actions\"><button type=\"button\" class=\"lb-info-btn\" data-info-open aria-haspopup=\"dialog\" aria-controls=\"lb-info\" aria-label=\"How this works\" title=\"How this works\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16.5\"/><line x1=\"12\" y1=\"7.5\" x2=\"12.01\" y2=\"7.5\"/></svg></button></div></header><main id=\"main-content\">\n      <div class=\"page-content-wrap lt-app\" id=\"lt-app\">\n        <h1 class=\"sr-only\">Letters - ConstBooth Studio</h1>\n\n        <div class=\"lt-controls\" id=\"lt-controls\" role=\"toolbar\" aria-label=\"Formatting toolbar\">\n          <div class=\"lt-controls-row lt-controls-row--top\">\n\n            <div class=\"lt-menu-anchor\" id=\"lt-anchor-paper\">\n              <button type=\"button\" class=\"lt-menu-btn\" id=\"lt-paper-trigger\" aria-haspopup=\"dialog\" aria-expanded=\"false\" title=\"Choose paper and texture\">\n                <span class=\"lt-swatch-thumb\" id=\"lt-active-swatch-thumb\"></span>\n                <span class=\"lt-menu-btn-label\" id=\"lt-active-paper-label\">Soft Cream</span>\n                <svg class=\"lt-chevron\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg>\n              </button>\n              <div class=\"lt-popover lt-popover--paper\" id=\"lt-popover-paper\" role=\"dialog\" aria-label=\"Paper choices\" hidden>\n                <div class=\"lt-popover-header\">\n                  <span class=\"lt-popover-title\">Paper Surface</span>\n                  <button type=\"button\" class=\"lt-popover-close\" id=\"lt-paper-close\" aria-label=\"Close paper menu\">\n                    <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>\n                  </button>\n                </div>\n                <div class=\"lt-papers-grid\" id=\"lt-papers\" role=\"radiogroup\" aria-label=\"Paper choices\"></div>\n                <div class=\"lt-popover-divider\"></div>\n                <div class=\"lt-popover-footer\">\n                  <button type=\"button\" class=\"lt-chip lt-chip--creases\" id=\"lt-folds\" aria-pressed=\"false\" title=\"Toggle fold creases\">\n                    <svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"4\" y=\"2.5\" width=\"16\" height=\"19\" rx=\"1.5\"/><path d=\"M4 9h16M4 15h16\" stroke-dasharray=\"2 2.4\"/></svg>\n                    <span>Fold Creases</span>\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"lt-menu-anchor\" id=\"lt-anchor-font\">\n              <button type=\"button\" class=\"lt-menu-btn\" id=\"lt-font-trigger\" aria-haspopup=\"listbox\" aria-expanded=\"false\" title=\"Choose handwriting font\">\n                <svg class=\"lt-menu-icon\" viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/></svg>\n                <span class=\"lt-menu-btn-label lt-active-font-specimen\" id=\"lt-active-font-label\">Marker</span>\n                <svg class=\"lt-chevron\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg>\n              </button>\n              <div class=\"lt-popover lt-popover--font\" id=\"lt-popover-font\" role=\"listbox\" aria-label=\"Handwriting fonts\" hidden>\n                <div class=\"lt-popover-header\">\n                  <span class=\"lt-popover-title\">Handwriting Style</span>\n                  <button type=\"button\" class=\"lt-popover-close\" id=\"lt-font-close\" aria-label=\"Close font menu\">\n                    <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>\n                  </button>\n                </div>\n                <div class=\"lt-fonts-list\" id=\"lt-fonts\" role=\"presentation\"></div>\n              </div>\n            </div>\n\n            <span class=\"lt-tool-sep\" aria-hidden=\"true\"></span>\n\n            <div class=\"lt-seg-group\" id=\"lt-sizes\" role=\"radiogroup\" aria-label=\"Text size\"></div>\n          </div>\n\n          <span class=\"lt-tool-sep lt-tool-sep--desktop\" aria-hidden=\"true\"></span>\n\n          <div class=\"lt-controls-row lt-controls-row--bottom\">\n\n            <div class=\"lt-inks-group\" id=\"lt-inks\" role=\"radiogroup\" aria-label=\"Ink color\"></div>\n\n            <span class=\"lt-tool-sep\" aria-hidden=\"true\"></span>\n\n            <div class=\"lt-seg-group\" id=\"lt-aligns\" role=\"radiogroup\" aria-label=\"Text alignment\"></div>\n\n            <span class=\"lt-tool-sep\" aria-hidden=\"true\"></span>\n\n            <div class=\"lt-undo-group\" role=\"group\" aria-label=\"Undo and redo\">\n              <button type=\"button\" class=\"lt-undo-btn\" id=\"lt-undo\" aria-label=\"Undo\" title=\"Undo (Ctrl+Z)\" disabled></button>\n              <button type=\"button\" class=\"lt-undo-btn\" id=\"lt-redo\" aria-label=\"Redo\" title=\"Redo (Ctrl+Shift+Z)\" disabled></button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"lt-stage\" id=\"lt-stage\"></div>\n\n      <div class=\"lt-obj-tools\" id=\"lt-obj-tools\" role=\"toolbar\" aria-label=\"Selected item\" hidden>\n        <button type=\"button\" class=\"lt-tool lt-tool--text\" data-action=\"size\" data-size=\"small\" aria-label=\"Small\">S</button>\n        <button type=\"button\" class=\"lt-tool lt-tool--text\" data-action=\"size\" data-size=\"medium\" aria-label=\"Medium\">M</button>\n        <button type=\"button\" class=\"lt-tool lt-tool--text\" data-action=\"size\" data-size=\"large\" aria-label=\"Large\">L</button>\n        <span class=\"lt-tool-sep\" aria-hidden=\"true\"></span>\n        <button type=\"button\" class=\"lt-tool\" id=\"lt-tool-rot-left\" data-action=\"rot-left\" aria-label=\"Rotate left\"></button>\n        <button type=\"button\" class=\"lt-tool\" id=\"lt-tool-rot-right\" data-action=\"rot-right\" aria-label=\"Rotate right\"></button>\n        <span class=\"lt-tool-sep\" aria-hidden=\"true\"></span>\n        <button type=\"button\" class=\"lt-tool lt-tool--danger\" id=\"lt-tool-delete\" data-action=\"delete\" aria-label=\"Remove\"></button>\n      </div>\n        <div class=\"lt-dock\" role=\"toolbar\" aria-label=\"Letter actions\">\n          <button type=\"button\" class=\"lt-dock-btn\" id=\"lt-add-photo\" aria-label=\"Add Photo\"><span>Add Photo</span></button>\n          <button type=\"button\" class=\"lt-dock-btn\" id=\"lt-add-strip\" aria-label=\"Add Strip\"><span>Add Strip</span></button>\n          <button type=\"button\" class=\"lt-dock-btn\" id=\"lt-add-deco\" aria-label=\"Stickers\"><span>Stickers</span></button>\n          <button type=\"button\" class=\"lt-dock-btn\" id=\"lt-details\" aria-label=\"Details\"><span>Details</span></button>\n          <button type=\"button\" class=\"lt-dock-btn lt-dock-btn--primary\" id=\"lt-finish-btn\"><span>Finish Letter</span></button>\n        </div>\n\n        <input type=\"file\" id=\"lt-file\" accept=\"image/jpeg,image/png\" multiple class=\"sr-only\" tabindex=\"-1\" aria-hidden=\"true\">\n\n      <div class=\"lt-scrim\" id=\"lt-scrim\" hidden></div>\n\n      <div class=\"lt-panel\" id=\"lt-panel-details\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lt-details-title\" hidden>\n        <div class=\"lt-panel-head\">\n          <h2 class=\"lt-panel-title\" id=\"lt-details-title\">Details</h2>\n          <button type=\"button\" class=\"lt-panel-close\" aria-label=\"Close\"></button>\n        </div>\n        <div class=\"lt-panel-body\">\n          <label class=\"lt-field\">\n            <span class=\"lt-field-label\">Date</span>\n            <div class=\"lt-date-wrap\">\n              <input type=\"text\" id=\"lt-field-date\" autocomplete=\"off\" placeholder=\"12 September\" maxlength=\"60\" readonly>\n              <input type=\"date\" id=\"lt-field-date-picker\" class=\"lt-date-native\" aria-label=\"Pick a date\" tabindex=\"-1\">\n              <button type=\"button\" class=\"lt-date-trigger\" id=\"lt-date-trigger\" aria-label=\"Open date picker\" title=\"Pick a date\">\n                <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>\n              </button>\n            </div>\n          </label>\n          <label class=\"lt-field\">\n            <span class=\"lt-field-label\">Who it is for <span class=\"lt-char-count\" id=\"lt-count-to\">0 / 80</span></span>\n            <input type=\"text\" id=\"lt-field-to\" autocomplete=\"off\" placeholder=\"Dear Maya,\" maxlength=\"80\">\n            <span class=\"lt-field-hint\">Goes at the top of the first page.</span>\n          </label>\n          <label class=\"lt-field\">\n            <span class=\"lt-field-label\">Sign-off <span class=\"lt-char-count\" id=\"lt-count-from\">0 / 120</span></span>\n            <textarea id=\"lt-field-from\" rows=\"2\" placeholder=\"Love,&#10;K\" maxlength=\"120\"></textarea>\n            <span class=\"lt-field-hint\">Goes at the bottom of the last page.</span>\n          </label>\n          <button type=\"button\" class=\"lt-dock-btn lt-dock-btn--primary\" id=\"lt-details-apply\"><span>Done</span></button>\n        </div>\n      </div>\n\n      <div class=\"lt-panel\" id=\"lt-panel-strips\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lt-strips-title\" hidden>\n        <div class=\"lt-panel-head\">\n          <h2 class=\"lt-panel-title\" id=\"lt-strips-title\">Your photo strips</h2>\n          <button type=\"button\" class=\"lt-panel-close\" aria-label=\"Close\"></button>\n        </div>\n        <div class=\"lt-panel-body\">\n          <p class=\"lt-empty\" id=\"lt-strip-loading\">Looking for your strips&hellip;</p>\n          <p class=\"lt-empty\" id=\"lt-strip-empty\" hidden>No strips yet. Make one in the <a href=\"/booth\">photo booth</a>, or use Add Photo to upload one.</p>\n          <div class=\"lt-strips\" id=\"lt-strip-list\"></div>\n        </div>\n      </div>\n\n      <div class=\"lt-panel\" id=\"lt-panel-deco\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lt-deco-title\" hidden>\n        <div class=\"lt-panel-head\">\n          <h2 class=\"lt-panel-title\" id=\"lt-deco-title\">Stickers</h2>\n          <button type=\"button\" class=\"lt-panel-close\" aria-label=\"Close\"></button>\n        </div>\n        <div class=\"lt-panel-body\">\n          <p class=\"lt-empty\" id=\"lt-deco-empty\" hidden>No stickers yet. Stickers coming soon.</p>\n          <div class=\"lt-panel-grid\" id=\"lt-deco-list\"></div>\n        </div>\n      </div>\n      <div class=\"lt-finish\" id=\"lt-finish\" aria-hidden=\"true\" hidden>\n        <div class=\"lt-fold-scene\">\n          <div class=\"lt-envelope-back\"></div>\n          <div class=\"lt-fold\">\n            <div class=\"lt-fold-panel lt-fold-panel--top\"></div>\n            <div class=\"lt-fold-panel lt-fold-panel--mid\"></div>\n            <div class=\"lt-fold-panel lt-fold-panel--bottom\"></div>\n          </div>\n          <div class=\"lt-envelope\">\n            <div class=\"lt-env-shape\">\n              <div class=\"lt-env-bottom\"></div>\n              <div class=\"lt-env-flap\"></div>\n              <div class=\"lt-env-seal\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"lt-final\" id=\"lt-final\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lt-final-title\" hidden>\n        <div class=\"lt-final-art\"><img id=\"lt-final-art\" alt=\"Your finished letter\"></div>\n        <div class=\"lt-final-content\">\n          <div class=\"lt-final-header\">\n            <h2 class=\"lt-final-title\" id=\"lt-final-title\" tabindex=\"-1\">Your <span class=\"lt-final-accent\">letter</span> is ready.</h2>\n            <p class=\"lt-final-sub\">Keep it, send it, or share it.</p>\n          </div>\n          <div class=\"lt-progress\" id=\"lt-progress\" role=\"status\" aria-live=\"polite\" hidden>\n            <div class=\"lt-progress-track\"><div class=\"lt-progress-fill\" id=\"lt-progress-fill\"></div></div>\n            <span class=\"lt-progress-text\" id=\"lt-progress-text\"></span>\n          </div>\n          <div class=\"lt-final-actions\">\n            <button type=\"button\" class=\"lt-final-btn lt-final-btn--primary\" id=\"lt-share\"><span>Share Letter</span></button>\n          </div>\n          <div class=\"lt-final-saves\" role=\"group\" aria-label=\"Save a copy\">\n            <button type=\"button\" class=\"lt-final-btn lt-final-btn--save\" id=\"lt-save-png\" aria-label=\"Save as PNG image\"><span>Save PNG</span></button>\n            <button type=\"button\" class=\"lt-final-btn lt-final-btn--save\" id=\"lt-save-pdf\" aria-label=\"Save as PDF\"><span>Save PDF</span></button>\n          </div>\n          <input type=\"text\" class=\"lt-share-link\" id=\"lt-share-link\" readonly aria-label=\"Link to your letter\" hidden>\n          <button type=\"button\" class=\"lt-final-secondary\" id=\"lt-edit\">Edit Letter</button>\n        </div>\n      </div>\n      </div>\n</main>\n<div class=\"lb-info\" id=\"lb-info\" hidden>\n  <div class=\"lb-info-backdrop\" data-info-close></div>\n  <div class=\"lb-info-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lb-info-title\">\n    <div class=\"lb-info-head\">\n      <h2 class=\"lb-info-title\" id=\"lb-info-title\">How Letters works</h2>\n      <button type=\"button\" class=\"lb-info-close\" data-info-close aria-label=\"Close\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg></button>\n    </div>\n    <ul class=\"lb-info-list\">\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg><span>No account needed.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"2.5\"/><line x1=\"11\" y1=\"18\" x2=\"13\" y2=\"18\"/></svg><span>While you write, your letter is saved as a draft in this browser only.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg><span>Nothing is shared until you press Share Letter. Then only people with your link can open it, and it isn&rsquo;t listed or searchable.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><polyline points=\"12 7 12 12 15.5 14\"/></svg><span>Shared letters are deleted after 30 days.</span></li>\n    </ul>\n    \n  </div>\n</div>\n<script src=\"/shared/header.min.js\"></script>\n<script src=\"/js/lb-guest-storage.js\"></script>\n<script src=\"/js/lb-export.js\"></script>\n<script src=\"/js/lb-input-guard.js\"></script>\n<script src=\"/js/studio/letters-model.js\"></script>\n<script src=\"/js/studio/letters-render.js\"></script>\n<script src=\"/js/studio/letters-pdf.js\"></script>\n<script src=\"/js/studio/letters-editor.js\"></script>\n<script src=\"/js/studio/studio-info.js\"></script>"
}