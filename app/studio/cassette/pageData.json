{
  "title": "Make a Digital Cassette: Record a Voice Tape | ConstBooth",
  "description": "Make a nostalgic digital cassette: pick a tape, put a photo and a note on the label, record a voice message and share it as a link. Free, no account needed.",
  "styles": [
    "/css/cassette.css",
    "/css/studio-info.css",
    "/css/site-consent.css"
  ],
  "bodyClass": "cs-page-body",
  "bodyAttrs": {},
  "html": "<a href=\"#main-content\" class=\"skip-link\">Skip to content</a><header class=\"mobile-header\"><a href=\"/studio\" class=\"mobile-back-btn\" id=\"mobile-back-btn\" aria-label=\"Go Back to Studio\" title=\"Back\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"20\" height=\"20\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg></a><a href=\"/\" class=\"mobile-logo\" aria-label=\"ConstBooth\"><img src=\"/assets/logo.svg?v=35ddb567\" alt=\"ConstBooth\" class=\"logo-img\" width=\"112\" height=\"30\"></a><button type=\"button\" class=\"lb-info-btn\" data-info-open aria-haspopup=\"dialog\" aria-controls=\"lb-info\" aria-label=\"How this works\" title=\"How this works\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16.5\"/><line x1=\"12\" y1=\"7.5\" x2=\"12.01\" y2=\"7.5\"/></svg></button></header><header class=\"main-header full-header lb-nav-bar\"><div class=\"header-left\"><a href=\"/studio\" id=\"nav-back-btn\" class=\"nav-back-btn\" aria-label=\"Back to Studio\" title=\"Back\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"18\" height=\"18\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg></a></div><a href=\"/\" id=\"logo-trigger\" class=\"app-logo\" aria-label=\"ConstBooth\"><img src=\"/assets/logo.svg?v=35ddb567\" alt=\"ConstBooth\" class=\"logo-img\" width=\"134\" height=\"36\"></a><div class=\"header-actions\"><button type=\"button\" class=\"lb-info-btn\" data-info-open aria-haspopup=\"dialog\" aria-controls=\"lb-info\" aria-label=\"How this works\" title=\"How this works\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16.5\"/><line x1=\"12\" y1=\"7.5\" x2=\"12.01\" y2=\"7.5\"/></svg></button></div></header><main id=\"main-content\">\n      <div class=\"page-content-wrap cs-app\" id=\"cs-app\" data-step=\"choose\" aria-busy=\"true\">\n\n        <section class=\"cs-step cs-choose\" id=\"cs-step-choose\" aria-labelledby=\"cs-choose-title\">\n          <div class=\"cs-head\">\n            <span class=\"cs-eyebrow\">Studio</span>\n            <h1 class=\"cs-title\" id=\"cs-choose-title\">Choose your <span class=\"cs-accent\">cassette</span>.</h1>\n            <p class=\"cs-sub\">Pick a tape, make the cover yours, then record something for someone.</p>\n          </div>\n          <div class=\"cs-carousel-wrap\">\n            <button type=\"button\" class=\"cs-carousel-arrow cs-carousel-prev\" id=\"cs-carousel-prev\" aria-label=\"Previous cassette\" title=\"Previous cassette\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"20\" height=\"20\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg>\n            </button>\n            <div class=\"cs-carousel-stage\" id=\"cs-carousel-stage\" tabindex=\"0\" role=\"region\" aria-label=\"Cassette 3D Carousel\" aria-live=\"polite\">\n              <div class=\"cs-designs\" id=\"cs-designs\" role=\"radiogroup\" aria-labelledby=\"cs-choose-title\"><label class=\"cs-design is-selected\" data-index=\"0\" data-pos=\"center\" aria-hidden=\"false\"><input type=\"radio\" name=\"cs-design\" autocomplete=\"off\" value=\"blue-side-a\" class=\"cs-design-input\"><span class=\"cs-design-art\"><img src=\"/assets/studio/cassette/blue-side-a.svg?v=6865f681\" alt=\"\" width=\"831\" height=\"506\" fetchpriority=\"high\"></span><span class=\"cs-design-name\">Blue Side A</span><span class=\"cs-design-tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"5 12.5 10 17.5 19 7\"></polyline></svg></span></label><label class=\"cs-design\" data-index=\"1\" data-pos=\"right\" aria-hidden=\"false\"><input type=\"radio\" name=\"cs-design\" autocomplete=\"off\" value=\"golden-mix\" class=\"cs-design-input\"><span class=\"cs-design-art\"><img src=\"/assets/studio/cassette/golden-mix.svg?v=a01037ed\" alt=\"\" width=\"831\" height=\"506\" decoding=\"async\"></span><span class=\"cs-design-name\">Golden Mix</span><span class=\"cs-design-tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"5 12.5 10 17.5 19 7\"></polyline></svg></span></label><label class=\"cs-design\" data-index=\"2\" data-pos=\"hidden-right\" aria-hidden=\"true\"><input type=\"radio\" name=\"cs-design\" autocomplete=\"off\" value=\"pink-pop\" class=\"cs-design-input\" tabindex=\"-1\"><span class=\"cs-design-art\"><img src=\"/assets/studio/cassette/pink-pop.svg?v=027d2e28\" alt=\"\" width=\"831\" height=\"506\" decoding=\"async\"></span><span class=\"cs-design-name\">Pink Pop</span><span class=\"cs-design-tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"5 12.5 10 17.5 19 7\"></polyline></svg></span></label><label class=\"cs-design\" data-index=\"3\" data-pos=\"hidden-left\" aria-hidden=\"true\"><input type=\"radio\" name=\"cs-design\" autocomplete=\"off\" value=\"rainbow-love\" class=\"cs-design-input\" tabindex=\"-1\"><span class=\"cs-design-art\"><img src=\"/assets/studio/cassette/rainbow-love.svg?v=5a9f072a\" alt=\"\" width=\"831\" height=\"506\" decoding=\"async\"></span><span class=\"cs-design-name\">Rainbow Love</span><span class=\"cs-design-tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"5 12.5 10 17.5 19 7\"></polyline></svg></span></label><label class=\"cs-design\" data-index=\"4\" data-pos=\"left\" aria-hidden=\"false\"><input type=\"radio\" name=\"cs-design\" autocomplete=\"off\" value=\"retro-green\" class=\"cs-design-input\"><span class=\"cs-design-art\"><img src=\"/assets/studio/cassette/retro-green.svg?v=3370513a\" alt=\"\" width=\"831\" height=\"506\" decoding=\"async\"></span><span class=\"cs-design-name\">Retro Green</span><span class=\"cs-design-tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"5 12.5 10 17.5 19 7\"></polyline></svg></span></label></div>\n            </div>\n            <button type=\"button\" class=\"cs-carousel-arrow cs-carousel-next\" id=\"cs-carousel-next\" aria-label=\"Next cassette\" title=\"Next cassette\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"20\" height=\"20\" aria-hidden=\"true\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\n            </button>\n          </div>\n          <div class=\"cs-carousel-dots\" id=\"cs-carousel-dots\" role=\"tablist\" aria-label=\"Cassette selector\"></div>\n          <div class=\"cs-actions\">\n            <button type=\"button\" class=\"cs-btn cs-btn--primary\" id=\"cs-choose-next\" disabled><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"13 6 19 12 13 18\"></polyline></svg><span>Continue</span></button>\n          </div>\n        </section>\n\n        <section class=\"cs-step cs-cover-step\" id=\"cs-step-cover\" aria-labelledby=\"cs-cover-title\" hidden>\n          <div class=\"cs-head\">\n            <h2 class=\"cs-title\" id=\"cs-cover-title\">Make the <span class=\"cs-accent\">cover</span> yours.</h2>\n            <p class=\"cs-sub\">Add a photo and a few words. The label updates as you go.</p>\n          </div>\n          <div class=\"cs-cover\">\n            <div class=\"cs-preview-col\">\n              <div class=\"cs-preview-frame\" id=\"cs-preview-frame\" role=\"img\" aria-label=\"Cassette preview\" tabindex=\"-1\">\n                <div class=\"cs-preview is-loading\" id=\"cs-preview\"></div>\n              </div>\n              <p class=\"cs-hint\" id=\"cs-photo-hint\" hidden>Drag the photo to move it. Arrow keys work too.</p>\n            </div>\n\n            <div class=\"cs-panel\">\n              <div class=\"cs-group\" role=\"group\" aria-labelledby=\"cs-photo-label\">\n                <div class=\"cs-group-head\"><h3 class=\"cs-group-label\" id=\"cs-photo-label\">Photo</h3></div>\n                <div class=\"cs-row\">\n                  <button type=\"button\" class=\"cs-btn cs-btn--small\" id=\"cs-photo-add\" aria-label=\"Upload photo\">\n                    <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect><circle cx=\"8.5\" cy=\"8.5\" r=\"1.8\"></circle><path d=\"M21 15l-5-5L5 21\"></path></svg>\n                    <span>Add photo</span>\n                  </button>\n                  <button type=\"button\" class=\"cs-btn cs-btn--small\" id=\"cs-photo-edit\" hidden>\n                    <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"></line><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"></line><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"></line><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"></line><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"></line><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"></line><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"></line><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"></line></svg>\n                    <span>Adjust photo</span>\n                  </button>\n                  <button type=\"button\" class=\"cs-btn cs-btn--small\" id=\"cs-photo-replace\" hidden>\n                    <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"23 4 23 10 17 10\"></polyline><polyline points=\"1 20 1 14 7 14\"></polyline><path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\"></path></svg>\n                    <span>Replace photo</span>\n                  </button>\n                  <button type=\"button\" class=\"cs-btn cs-btn--small cs-btn--quiet\" id=\"cs-photo-remove\" hidden><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6\"></path><path d=\"M10 11v6M14 11v6\"></path><path d=\"M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2\"></path></svg><span>Remove photo</span></button>\n                </div>\n                <div class=\"cs-adjust\" id=\"cs-photo-adjust\" hidden>\n                  <label class=\"cs-zoom\" for=\"cs-photo-zoom\">\n                    <span>Zoom</span>\n                    <input type=\"range\" id=\"cs-photo-zoom\" min=\"1\" max=\"3\" step=\"0.01\" value=\"1\" autocomplete=\"off\">\n                  </label>\n                  <div class=\"cs-row\">\n                    <span class=\"cs-adjust-tip\">Drag the photo on the cassette to reposition it.</span>\n                    <button type=\"button\" class=\"cs-btn cs-btn--small cs-btn--primary\" id=\"cs-photo-done\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg><span>Done</span></button>\n                  </div>\n                </div>\n                <input type=\"file\" id=\"cs-file\" accept=\"image/jpeg,image/png,.jpg,.jpeg,.png\" class=\"sr-only\" tabindex=\"-1\" aria-hidden=\"true\">\n              </div>\n\n              <div class=\"cs-group\">\n                <div class=\"cs-group-head\">\n                  <label class=\"cs-group-label\" for=\"cs-message\">Message</label>\n                  <span class=\"cs-count\" id=\"cs-message-count\">0 / 60</span>\n                </div>\n                <div class=\"cs-row\">\n                  <input type=\"text\" class=\"cs-input\" id=\"cs-message\" maxlength=\"60\" placeholder=\"Write something...\" autocomplete=\"off\" enterkeyhint=\"done\">\n                  <button type=\"button\" class=\"cs-btn cs-btn--small cs-btn--quiet\" id=\"cs-message-clear\" aria-label=\"Clear message\" hidden><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg><span>Clear</span></button>\n                </div>\n              </div>\n\n              <div class=\"cs-group\" role=\"group\" aria-labelledby=\"cs-date-label\">\n                <div class=\"cs-group-head\"><h3 class=\"cs-group-label\" id=\"cs-date-label\">Date <span class=\"cs-count\">(optional)</span></h3></div>\n                <button type=\"button\" class=\"cs-btn cs-btn--small\" id=\"cs-date-add\" aria-label=\"Add date\">\n                  <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg>\n                  <span>Add date</span>\n                </button>\n                <div class=\"cs-row\" id=\"cs-date-row\" hidden>\n                  <input type=\"date\" class=\"cs-input\" id=\"cs-date\" aria-label=\"Date on the label\" autocomplete=\"off\">\n                  <button type=\"button\" class=\"cs-btn cs-btn--small cs-btn--quiet\" id=\"cs-date-remove\" aria-label=\"Remove date\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg><span>Remove date</span></button>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"cs-actions\">\n            <button type=\"button\" class=\"cs-btn\" id=\"cs-cover-back\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"11 18 5 12 11 6\"></polyline></svg><span>Back</span></button>\n            <button type=\"button\" class=\"cs-btn cs-btn--primary\" id=\"cs-cover-next\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"13 6 19 12 13 18\"></polyline></svg><span>Continue</span></button>\n          </div>\n        </section>\n\n        <section class=\"cs-step cs-record\" id=\"cs-step-record\" aria-labelledby=\"cs-record-title\" hidden>\n          <div class=\"cs-head\">\n            <h2 class=\"cs-title\" id=\"cs-record-title\">Record your <span class=\"cs-accent\">tape</span>.</h2>\n          </div>\n          <div class=\"cs-deck-mount\" id=\"cs-deck-mount\"></div>\n          <p class=\"cs-status\" id=\"cs-record-status\" role=\"status\" aria-live=\"polite\">Press REC when you&rsquo;re ready. Up to 5 minutes.</p>\n          <div class=\"cs-alert\" id=\"cs-record-error\" role=\"alert\" hidden>\n            <p id=\"cs-record-error-text\"></p>\n            <button type=\"button\" class=\"cs-btn cs-btn--small\" id=\"cs-record-retry\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"></polyline><path d=\"M3.5 15a9 9 0 1 0 2.1-9.4L1 10\"></path></svg><span>Try again</span></button>\n          </div>\n          <audio id=\"cs-audio\" preload=\"metadata\" playsinline hidden></audio>\n          <div class=\"cs-actions\">\n            <button type=\"button\" class=\"cs-btn\" id=\"cs-record-back\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"></path><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"></path></svg><span>Edit cover</span></button>\n            <button type=\"button\" class=\"cs-btn cs-btn--primary\" id=\"cs-finish\" disabled><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg><span>Finish cassette</span></button>\n          </div>\n        </section>\n\n        <section class=\"cs-step cs-final\" id=\"cs-step-final\" aria-labelledby=\"cs-final-title\" hidden>\n          <div class=\"cs-head\">\n            <h2 class=\"cs-title\" id=\"cs-final-title\" aria-live=\"polite\">Your cassette is ready.</h2>\n          </div>\n          <div class=\"cs-final-art\" id=\"cs-final-art\"></div>\n          <div class=\"cs-progress\" id=\"cs-final-progress\" role=\"status\" hidden>\n            <div class=\"cs-progress-track\"><span class=\"cs-progress-bar\"></span></div>\n            <span class=\"cs-progress-text\" id=\"cs-final-progress-text\"></span>\n          </div>\n          <div class=\"cs-alert\" id=\"cs-save-error\" role=\"alert\" hidden>\n            <p id=\"cs-save-error-text\">Couldn&rsquo;t save your cassette.</p>\n            <button type=\"button\" class=\"cs-btn cs-btn--small\" id=\"cs-save-retry\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"></polyline><path d=\"M3.5 15a9 9 0 1 0 2.1-9.4L1 10\"></path></svg><span>Try again</span></button>\n          </div>\n          <div class=\"cs-actions\">\n            <button type=\"button\" class=\"cs-btn cs-btn--primary\" id=\"cs-share\" disabled>\n              <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7\"></path><polyline points=\"16 6 12 2 8 6\"></polyline><line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"15\"></line></svg>\n              <span>Share cassette</span>\n            </button>\n            <button type=\"button\" class=\"cs-btn\" id=\"cs-save\" aria-label=\"Save video\">\n              <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2.5\" y=\"5.5\" width=\"13\" height=\"13\" rx=\"2.5\"></rect><path d=\"M15.5 10.2l6-3.2v10l-6-3.2z\"></path></svg>\n              <span>Save video</span>\n            </button>\n          </div>\n          <div class=\"cs-progress cs-video-progress\" id=\"cs-video-progress\" role=\"status\" hidden>\n            <div class=\"cs-progress-track\"><span class=\"cs-progress-fill\" id=\"cs-video-fill\"></span></div>\n            <span class=\"cs-progress-text\" id=\"cs-video-text\">Making your video&hellip;</span>\n            <span class=\"cs-progress-hint\">Keep this page open. The video plays through once while it records.</span>\n            <button type=\"button\" class=\"cs-btn cs-btn--quiet cs-btn--small\" id=\"cs-video-cancel\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg><span>Cancel</span></button>\n          </div>\n          <input type=\"text\" class=\"cs-input cs-share-link\" id=\"cs-share-link\" readonly aria-label=\"Link to your cassette\" hidden>\n          <div class=\"cs-final-more\">\n            <button type=\"button\" class=\"cs-btn cs-btn--quiet\" id=\"cs-final-edit\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"11 19 2 12 11 5 11 19\"></polygon><polygon points=\"22 19 13 12 22 5 22 19\"></polygon></svg><span>Back to recording</span></button>\n            <button type=\"button\" class=\"cs-btn cs-btn--quiet\" id=\"cs-start-over\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg><span>Make another cassette</span></button>\n          </div>\n        </section>\n      </div>\n\n\n</main>\n<div class=\"lb-info\" id=\"lb-info\" hidden>\n  <div class=\"lb-info-backdrop\" data-info-close></div>\n  <div class=\"lb-info-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lb-info-title\">\n    <div class=\"lb-info-head\">\n      <h2 class=\"lb-info-title\" id=\"lb-info-title\">How Cassette works</h2>\n      <button type=\"button\" class=\"lb-info-close\" data-info-close aria-label=\"Close\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg></button>\n    </div>\n    <ul class=\"lb-info-list\">\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg><span>No account needed.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"2\" width=\"6\" height=\"12\" rx=\"3\"/><path d=\"M5 10v1a7 7 0 0 0 14 0v-1\"/><line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"22\"/></svg><span>Your microphone only turns on when you press REC.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"2.5\"/><line x1=\"11\" y1=\"18\" x2=\"13\" y2=\"18\"/></svg><span>Your recording and photo stay on your device until you finish your cassette.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg><span>Only people with your link can open it. It isn&rsquo;t listed or searchable.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><polyline points=\"12 7 12 12 15.5 14\"/></svg><span>Cassettes are deleted after 30 days.</span></li>\n    </ul>\n    \n  </div>\n</div>\n\n<footer>\n  <nav class=\"lb-minimal-legal\" aria-label=\"Legal & Information\">\n    <div class=\"lb-minimal-legal-inner\">\n      <div class=\"lb-minimal-brand\">\n        <a href=\"/\" class=\"lb-minimal-logo\" aria-label=\"ConstBooth\">\n          <img src=\"/assets/logo-footer.svg?v=b1cb43c4\" alt=\"ConstBooth\" class=\"footer-logo-img\" width=\"112\" height=\"30\">\n        </a>\n        <span class=\"lb-minimal-copy\">&copy; 2026 ConstBooth. All rights reserved.</span>\n      </div>\n      <div class=\"lb-minimal-links\"><a href=\"/\">Home</a><a href=\"/strips\">Strips</a><a href=\"/studio\">Studio</a></div>\n    </div>\n  </nav>\n</footer><script src=\"/shared/header.min.js\"></script>\n<script src=\"/js/lb-export.js\"></script>\n<script src=\"/js/lb-input-guard.js\"></script>\n<script src=\"/js/studio/cassette-art.js\"></script>\n<script src=\"/js/studio/cassette-deck.js\"></script>\n<script src=\"/js/studio/cassette-video.js\"></script>\n<script src=\"/js/studio/cassette-editor.js\"></script>\n<script src=\"/js/studio