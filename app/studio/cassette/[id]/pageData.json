  "bodyClass": "cs-page-body",
  "bodyAttrs": {},
  "html": "<a href=\"#main-content\" class=\"skip-link\">Skip to content</a><header class=\"mobile-header\"><a href=\"/\" class=\"mobile-back-btn\" id=\"mobile-back-btn\" aria-label=\"Go to ConstBooth\" title=\"Home\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"20\" height=\"20\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg></a><a href=\"/\" class=\"mobile-logo\" aria-label=\"ConstBooth\"><img src=\"/assets/logo.svg?v=35ddb567\" alt=\"ConstBooth\" class=\"logo-img\" width=\"112\" height=\"30\"></a><button type=\"button\" class=\"lb-info-btn\" data-info-open aria-haspopup=\"dialog\" aria-controls=\"lb-info\" aria-label=\"About this cassette\" title=\"About this cassette\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16.5\"/><line x1=\"12\" y1=\"7.5\" x2=\"12.01\" y2=\"7.5\"/></svg></button></header><header class=\"main-header full-header lb-nav-bar\"><div class=\"header-left\"><a href=\"/\" id=\"nav-back-btn\" class=\"nav-back-btn\" aria-label=\"Go to ConstBooth\" title=\"Home\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" width=\"18\" height=\"18\" aria-hidden=\"true\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg></a></div><a href=\"/\" id=\"logo-trigger\" class=\"app-logo\" aria-label=\"ConstBooth\"><img src=\"/assets/logo.svg?v=35ddb567\" alt=\"ConstBooth\" class=\"logo-img\" width=\"134\" height=\"36\"></a><div class=\"header-actions\"><button type=\"button\" class=\"lb-info-btn\" data-info-open aria-haspopup=\"dialog\" aria-controls=\"lb-info\" aria-label=\"About this cassette\" title=\"About this cassette\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16.5\"/><line x1=\"12\" y1=\"7.5\" x2=\"12.01\" y2=\"7.5\"/></svg></button></div></header><main id=\"main-content\">\n      <div class=\"page-content-wrap cs-view\" id=\"cs-view\" data-state=\"LOADING\">\n        <div class=\"cs-view-panel\" id=\"cs-view-loading\" role=\"status\">\n          <p class=\"cs-sub\">Fetching your cassette&hellip;</p>\n        </div>\n\n        <div id=\"cs-view-main\" hidden>\n          <div class=\"cs-head\">\n            <h1 class=\"cs-title\">Someone sent you a <span class=\"cs-accent\">cassette</span>.</h1>\n          </div>\n          <div class=\"cs-deck-mount\" id=\"cs-deck-mount\"></div>\n          <p class=\"cs-status\" id=\"cs-view-status\" role=\"status\" aria-live=\"polite\"></p>\n          <div class=\"cs-volume\" role=\"group\" aria-label=\"Volume\">\n            <button type=\"button\" class=\"cs-btn cs-btn--small cs-mute\" id=\"cs-mute\" aria-pressed=\"false\" aria-label=\"Mute\">\n              <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon><path d=\"M15.5 8.5a5 5 0 0 1 0 7\"></path></svg>\n              <span id=\"cs-mute-text\">Mute</span>\n            </button>\n            <input type=\"range\" id=\"cs-volume\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" aria-label=\"Volume\">\n          </div>\n          <p class=\"cs-note\" id=\"cs-view-note\" hidden><span id=\"cs-view-note-text\"></span></p>\n          <audio id=\"cs-audio\" preload=\"none\" playsinline hidden></audio>\n          <div class=\"cs-actions\">\n            <button type=\"button\" class=\"cs-btn\" id=\"cs-view-save\" aria-label=\"Save video\">\n              <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2.5\" y=\"5.5\" width=\"13\" height=\"13\" rx=\"2.5\"></rect><path d=\"M15.5 10.2l6-3.2v10l-6-3.2z\"></path></svg>\n              <span>Save video</span>\n            </button>\n            <a class=\"cs-btn cs-btn--primary\" href=\"/studio/cassette\">\n              <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"18\" height=\"18\"><circle cx=\"12\" cy=\"12\" r=\"6\" fill=\"#F12850\"></circle></svg>\n              <span>Record one back</span>\n            </a>\n          </div>\n          <div class=\"cs-progress cs-video-progress\" id=\"cs-video-progress\" role=\"status\" hidden>\n            <div class=\"cs-progress-track\"><span class=\"cs-progress-fill\" id=\"cs-video-fill\"></span></div>\n            <span class=\"cs-progress-text\" id=\"cs-video-text\">Making your video&hellip;</span>\n            <span class=\"cs-progress-hint\">Keep this page open. The video plays through once while it records.</span>\n            <button type=\"button\" class=\"cs-btn cs-btn--quiet cs-btn--small\" id=\"cs-video-cancel\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg><span>Cancel</span></button>\n          </div>\n        </div>\n\n        <div class=\"cs-view-panel\" id=\"cs-view-error\" hidden>\n          <h1 class=\"cs-title\" id=\"cs-view-error-title\" tabindex=\"-1\">This cassette isn&rsquo;t available.</h1>\n          <p class=\"cs-sub\" id=\"cs-view-error-text\"></p>\n          <div class=\"cs-actions\">\n            <button type=\"button\" class=\"cs-btn\" id=\"cs-view-retry\" hidden><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"></polyline><path d=\"M3.5 15a9 9 0 1 0 2.1-9.4L1 10\"></path></svg><span>Try again</span></button>\n            <a class=\"cs-btn cs-btn--primary\" href=\"/studio/cassette\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg><span>Make a cassette</span></a>\n          </div>\n        </div>\n      </div>\n\n\n\n\n</main>\n<div class=\"lb-info\" id=\"lb-info\" hidden>\n  <div class=\"lb-info-backdrop\" data-info-close></div>\n  <div class=\"lb-info-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lb-info-title\">\n    <div class=\"lb-info-head\">\n      <h2 class=\"lb-info-title\" id=\"lb-info-title\">About this cassette</h2>\n      <button type=\"button\" class=\"lb-info-close\" data-info-close aria-label=\"Close\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg></button>\n    </div>\n    <ul class=\"lb-info-list\">\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2.5\"/><circle cx=\"8\" cy=\"11\" r=\"2\"/><circle cx=\"16\" cy=\"11\" r=\"2\"/><line x1=\"10\" y1=\"11\" x2=\"14\" y2=\"11\"/><path d=\"M6 19l2-4h8l2 4\"/></svg><span>Someone made this cassette for you on ConstBooth.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg><span>No account needed to listen.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg><span>Only people with this link can open it. It isn&rsquo;t listed or searchable.</span></li>\n      <li><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><polyline points=\"12 7 12 12 15.5 14\"/></svg><span>Cassettes are deleted 30 days after they&rsquo;re made.</span></li>\n    </ul>\n    <a class=\"lb-info-link\" href=\"/privacy\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"8\" y1=\"13\" x2=\"16\" y2=\"13\"/><line x1=\"8\" y1=\"17\" x2=\"13\" y2=\"17\"/></svg><span>Read our Privacy Policy</span></a>\n  </div>\n</div>\n\n<footer>\n  <nav class=\"lb-minimal-legal\" aria-label=\"Legal & Information\">\n    <div class=\"lb-minimal-legal-inner\">\n      <div class=\"lb-minimal-brand\">\n        <a href=\"/\" class=\"lb-minimal-logo\" aria-label=\"ConstBooth\">\n          <img src=\"/assets/logo-footer.svg?v=b1cb43c4\" alt=\"ConstBooth\" class=\"footer-logo-img\" width=\"112\" height=\"30\">\n        </a>\n        <span class=\"lb-minimal-copy\">&copy; 2026 ConstBooth. All rights reserved.</span>\n      </div>\n      <div class=\"lb-minimal-links\">\n        <a href=\"/studio/cassette\">Make a cassette</a>\n        <a href=\"/about\">About</a>\n        <a href=\"/privacy\">Privacy</a>\n        <a href=\"/terms\">Terms</a>\n        <a href=\"/contact\">Contact</a>\n        <button type=\"button\" class=\"footer-cookie-prefs lb-minimal-cookie-prefs\" id=\"footer-cookie-prefs\">Cookie Preferences</button>\n      </div>\n    </div>\n  </nav>\n</footer>\n<script nonce=\"sRMNmPFf5PoXiie08WjMwg==\">(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.nonce='sRMNmPFf5PoXiie08WjMwg==';d.innerHTML=\"window.__CF$cv$params={r:'a4de751c6e2f8194',t:'MTc5MjU2Njc4Mw=='};var a=document.createElement('script');a.nonce='sRMNmPFf5PoXiie08WjMwg==';a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script>\n<script src=\"/shared/header.min.js\"></script>\n<script src=\"/js/lb-export.js\"></script>\n<script src=\"/js/studio/cassette-art.js\"></script>\n<script src=\"/js/studio/cassette-deck.js\"></script>\n<script src=\"/js/studio/cassette-video.js\"></script>\n<script src=\"/js/studio/cassette-view.js\"></script>\n<script src=\"/js/studio/studio-info.js\"></script>"
